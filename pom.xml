<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>dev.learning</groupId><artifactId>learning-mall</artifactId><version>1.0.0</version>
  <name>Spring Boot Learning Mall</name>
  <description>可运行、可实验、可逐步阅读的 Spring Boot 教学商城</description>
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <langchain4j.version>1.20.0</langchain4j.version>
    <langchain4j-community.version>1.20.0-beta30</langchain4j-community.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-bom</artifactId>
        <version>${langchain4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-community-bom</artifactId>
        <version>${langchain4j-community.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <!-- Flyway 从 10 起把各家数据库的支持拆成独立模块：只有 flyway-core 的话，
         连上 MySQL 会直接抛 "Unsupported Database: MySQL 8.0"，应用起不来。
         版本与 flyway-core 必须一致（都由 spring-boot-starter-parent 托管）。 -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <!-- MySQL 驱动：主库已从 H2 换成 MySQL 8（理由见 application.yml 里的注释）。
         版本由 spring-boot-starter-parent 托管（3.5.16 → 9.7.0），这里不写死。 -->
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <!-- H2 只留给测试：application-test.yml 用 MODE=MySQL 跑在内存里。
         保留 runtime 范围，测试类路径才拿得到。 -->
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <!-- 购物助手：LangChain4j 核心 + 模型集成（智谱 GLM / DeepSeek 兼容 OpenAI） -->
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j</artifactId></dependency>
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j-community-zhipu-ai</artifactId></dependency>
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j-open-ai</artifactId></dependency>
    <!-- RAG 知识库：进程内中文嵌入模型 BGE-small-zh-v1.5（ONNX 量化版，离线运行，无需 API Key） -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings-bge-small-zh-v15-q</artifactId>
      <version>1.20.0-beta30</version>
    </dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <!-- 基准测试（*BenchmarkTest）默认不进全量回归：它产出的是数字，不是红绿，
         让它参与构建只会让「构建时间」随机器抖动。需要时单跑，-Dtest 会覆盖这里的 excludes：
         mvn -o test -Dtest=CatalogScaleBenchmarkTest -DfailIfNoTests=false -->
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-surefire-plugin</artifactId>
      <configuration>
        <excludes>
          <exclude>**/*BenchmarkTest.java</exclude>
        </excludes>
      </configuration>
    </plugin>
  </plugins></build>
</project>
